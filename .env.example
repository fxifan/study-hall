# Copy to .env.local and fill in. Never commit real values (.env* is gitignored except this file).
# "Phase N" marks variables that nothing reads yet; they're listed so the full set lives in one place.

# --- App -------------------------------------------------------------------
# Public base URL, used to build magic-link redirects. http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Sydney region) ----------------------------------------------
# Project Settings -> API Keys. The legacy anon / service_role keys also work.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses RLS. Used by scripts/, tests/ and (from Phase 1) webhooks and cron.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Connect -> "Session pooler" connection string, with your database password filled in.
# Used by `npm run db:migrate` and `npm run db:types` only.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# --- Seed data (dev only) --------------------------------------------------
# Domain for the seeded test accounts, e.g. admin@studyhall.test.
SEED_EMAIL_DOMAIN=studyhall.test

# --- Stripe: Study Hall's own account, TEST mode --------------------------
# Dashboard -> Developers -> API keys (test mode). Then run `npm run stripe:setup`.
STRIPE_SECRET_KEY=sk_test_xxx
# From `npm run stripe:setup -- --webhook <https url>/api/stripe/webhook` (saved to .stripe-webhook-secret).
# Optional locally: /onboarding/complete confirms payments without the webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Live keys are refused unless this is 1. Only set it once live payments are approved.
STRIPE_ALLOW_LIVE=
# Used by stripe:setup for the Customer Portal's links (defaults to the Vercel production URL).
NEXT_PUBLIC_PRODUCTION_URL=https://study-hall-murex.vercel.app

# --- Consent records -------------------------------------------------------
# Random string used to hash IP addresses in consents.ip_hash. Generate with: openssl rand -hex 32
IP_HASH_SALT=

# --- Email via Resend ---------------------------------------------------------
# Tutor product (/app). Until REPORTS_FROM_EMAIL is on a domain verified in Resend, tutors send
# reports and invoices from their own email app (pre-filled email / phone share sheet) and there are
# no automatic overdue reminders. With a key and a verified sender, Study Hall sends them itself.
# Resend's shared test sender (onboarding@resend.dev) only delivers to your Resend account's email:
# set TUTOR_EMAIL_MODE=app to test sending with it. Without a key, "app" mode writes emails to
# email-previews/outbox/ instead of sending.
RESEND_API_KEY=re_xxx
REPORTS_FROM_EMAIL="Study Hall <reports@your-domain>"
# Optional: "own" or "app" (default: "app" only with a key and a non-resend.dev sender).
TUTOR_EMAIL_MODE=

# --- Tutor product (/app): AI and encryption ---------------------------------
# OpenAI: transcription and report drafting. Without a key, local dev uses a stand-in drafter
# (never in production). OpenAI doesn't train on API data; requests set store=false.
OPENAI_API_KEY=
# Optional overrides (defaults shown).
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_REPORT_MODEL=gpt-4.1-mini
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts tutors' bank details. Keep it safe:
# losing or changing it makes saved bank details unreadable (tutors re-enter them).
TUTOR_DATA_KEY=

# --- Vercel Cron -------------------------------------------------------------
# Sent by Vercel Cron as "Authorization: Bearer <CRON_SECRET>" to /api/cron/*.
CRON_SECRET=
